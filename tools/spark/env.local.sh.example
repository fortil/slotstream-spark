# Copy to private/env.local.sh (ignored by git). tools/spark/env.sh sources it on the Mac and on the Spark.
# Every knob is optional; the value shown is the generic default.
# Set SLOTSTREAM_SKIP_LOCAL=1 in the environment to ignore private/env.local.sh.

# ssh target of the Spark (<login>@<host> or an ssh config alias).
export SPARK_HOST=spark

# URL of the model router's "running models" endpoint, for hosts that share the GPU memory
# with other model servers. Empty means there is no router to watch.
export SLOTSTREAM_RUNNING_URL=

# Number of containers that must stay up before and after a heavy run. Empty means do not count.
export EXPECTED_CONTAINERS=

# NVMe device that holds the packed experts, as named under /sys/block.
export SLOTSTREAM_NVME_DEVICE=nvme0n1

# Temperature input of the NVMe drive. Empty means discover it under /sys/class/hwmon.
# export SLOTSTREAM_HWMON_INPUT=

# Virtualenv for the download and conversion tools. Empty means $R/venv-tools.
# export SLOTSTREAM_TOOLS_VENV=
